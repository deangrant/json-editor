{
  "name": "json-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Browser JSON editor monorepo — domain core and web app.",
  "keywords": [
    "json",
    "editor",
    "monorepo"
  ],
  "license": "MIT",
  "author": "Dean Grant",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "pnpm --filter @json-editor/web dev",
    "doctor": "react-doctor",
    "doctor:changed": "react-doctor --verbose --scope changed --yes",
    "doctor:full": "react-doctor --verbose --yes",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:lockfile": "pnpm install --frozen-lockfile",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify": "pnpm exec biome ci . && pnpm run typecheck && pnpm test && pnpm lint:lockfile && pnpm audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "react-doctor": "0.9.1",
    "typescript": "catalog:",
    "ultracite": "7.10.2"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  }
}
